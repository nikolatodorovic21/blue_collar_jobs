# Dev defaults. For production, follow the deploy-time checklist:
# docs/wiki/security-hardening.md → "Production secrets" → "Deploy-time checklist"
# In particular: regenerate JWT_SECRET / CSRF_SECRET with `openssl rand -base64 32`
# and supply them via the deploy environment's secret manager, never commit them.

MONGODB_URI=mongodb://localhost:27017/jobs-db
PORT=5000
JWT_SECRET=
CSRF_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# LOG_LEVEL=debug
